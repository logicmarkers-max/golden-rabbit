<!-- Diwali Celebration Box Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="luxuryGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8b0000;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#ffd700;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#8b4513;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="ribbonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffd700;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ffed4e;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="sparkleGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#fff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ffd700;stop-opacity:0.3" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#luxuryGrad)" />
  
  <!-- Gift Box Base -->
  <rect x="100" y="120" width="100" height="60" fill="#8b0000" stroke="#ffd700" stroke-width="2" rx="3"/>
  
  <!-- Box Top -->
  <rect x="95" y="115" width="110" height="15" fill="#a52a2a" stroke="#ffd700" stroke-width="1" rx="3"/>
  
  <!-- Golden Ribbon Horizontal -->
  <rect x="85" y="140" width="130" height="8" fill="url(#ribbonGrad)" rx="4"/>
  
  <!-- Golden Ribbon Vertical -->
  <rect x="146" y="105" width="8" height="85" fill="url(#ribbonGrad)" rx="4"/>
  
  <!-- Ribbon Bow -->
  <ellipse cx="140" cy="115" rx="12" ry="6" fill="url(#ribbonGrad)"/>
  <ellipse cx="160" cy="115" rx="12" ry="6" fill="url(#ribbonGrad)"/>
  <circle cx="150" cy="115" r="5" fill="#ffd700"/>
  
  <!-- Box Content Preview (slightly open) -->
  <rect x="105" y="125" width="90" height="8" fill="#2c2c2c" opacity="0.8"/>
  
  <!-- Mini Fireworks Inside Box -->
  <g opacity="0.7">
    <!-- Mini sparklers -->
    <rect x="110" y="127" width="2" height="4" fill="#ffd700"/>
    <rect x="115" y="127" width="2" height="4" fill="#ffd700"/>
    <rect x="120" y="127" width="2" height="4" fill="#ffd700"/>
    
    <!-- Mini rockets -->
    <ellipse cx="135" cy="129" rx="3" ry="1.5" fill="#ff4757"/>
    <ellipse cx="145" cy="129" rx="3" ry="1.5" fill="#ff4757"/>
    
    <!-- Mini chakkars -->
    <circle cx="165" cy="129" r="2" fill="#ff6b35"/>
    <circle cx="175" cy="129" r="2" fill="#ff6b35"/>
    <circle cx="185" cy="129" r="2" fill="#ff6b35"/>
  </g>
  
  <!-- Diwali Decorative Elements -->
  <g>
    <!-- Diya (Oil Lamp) Left -->
    <ellipse cx="60" cy="160" rx="8" ry="3" fill="#8b4513"/>
    <ellipse cx="60" cy="158" rx="6" ry="2" fill="#ffd700"/>
    <ellipse cx="60" cy="155" rx="3" ry="1" fill="#ff4757">
      <animate attributeName="ry" values="1;1.5;1" dur="2s" repeatCount="indefinite"/>
      <animate attributeName="fill" values="#ff4757;#ffd700;#ff4757" dur="2s" repeatCount="indefinite"/>
    </ellipse>
    
    <!-- Diya (Oil Lamp) Right -->
    <ellipse cx="240" cy="160" rx="8" ry="3" fill="#8b4513"/>
    <ellipse cx="240" cy="158" rx="6" ry="2" fill="#ffd700"/>
    <ellipse cx="240" cy="155" rx="3" ry="1" fill="#ff4757">
      <animate attributeName="ry" values="1;1.5;1" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="fill" values="#ff4757;#ffd700;#ff4757" dur="1.8s" repeatCount="indefinite"/>
    </ellipse>
  </g>
  
  <!-- Festive Sparkles Around Box -->
  <g>
    <circle cx="80" cy="100" r="2" fill="url(#sparkleGrad)" opacity="0.8">
      <animate attributeName="opacity" values="0.8;1;0.3;1;0.8" dur="2.5s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.5;3;1;3;1.5" dur="2.5s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="220" cy="100" r="1.8" fill="url(#sparkleGrad)" opacity="0.9">
      <animate attributeName="opacity" values="0.9;1;0.4;1;0.9" dur="2.2s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.3;2.5;0.8;2.5;1.3" dur="2.2s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="70" cy="140" r="1.5" fill="url(#sparkleGrad)" opacity="0.7">
      <animate attributeName="opacity" values="0.7;1;0.2;1;0.7" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1;2;0.5;2;1" dur="3s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="230" cy="140" r="2.2" fill="url(#sparkleGrad)" opacity="0.6">
      <animate attributeName="opacity" values="0.6;1;0.3;1;0.6" dur="2.8s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.8;3.2;1.2;3.2;1.8" dur="2.8s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Celebratory Burst Above Box -->
  <g opacity="0.6">
    <line x1="150" y1="90" x2="170" y2="70" stroke="#ffd700" stroke-width="2">
      <animate attributeName="opacity" values="0.6;1;0.2;1;0.6" dur="1.5s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="90" x2="130" y2="70" stroke="#ff4757" stroke-width="2">
      <animate attributeName="opacity" values="0.6;1;0.3;1;0.6" dur="1.3s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="90" x2="160" y2="60" stroke="#ffed4e" stroke-width="1.5">
      <animate attributeName="opacity" values="0.6;1;0.4;1;0.6" dur="1.7s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="90" x2="140" y2="60" stroke="#ff6b35" stroke-width="1.5">
      <animate attributeName="opacity" values="0.6;1;0.2;1;0.6" dur="1.4s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- "Diwali Special" Text -->
  <text x="150" y="50" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="16" font-weight="bold">
    Diwali Special
  </text>
  
  <!-- Decorative Rangoli Pattern -->
  <g stroke="#ffd700" stroke-width="1" fill="none" opacity="0.5">
    <circle cx="150" cy="190" r="20"/>
    <circle cx="150" cy="190" r="15">
      <animateTransform attributeName="transform" type="rotate" values="0 150 190;360 150 190" dur="10s" repeatCount="indefinite"/>
    </circle>
    <circle cx="150" cy="190" r="10">
      <animateTransform attributeName="transform" type="rotate" values="360 150 190;0 150 190" dur="8s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="120" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="70" y="187" text-anchor="middle" fill="#ffd700" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Diwali Celebration Box
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>