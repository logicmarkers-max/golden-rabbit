<!-- Celebration Bomb Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bombGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#000;stop-opacity:1" />
      <stop offset="70%" style="stop-color:#333;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#666;stop-opacity:1" />
    </radialGradient>
    <linearGradient id="explosionGrad" x1="50%" y1="50%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fff;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#ffd700;stop-opacity:0.9" />
      <stop offset="70%" style="stop-color:#ff4757;stop-opacity:0.7" />
      <stop offset="100%" style="stop-color:#ff6b35;stop-opacity:0.3" />
    </linearGradient>
    <linearGradient id="fuseGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8b4513;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#654321;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="#1a1a1a" />
  
  <!-- Ground -->
  <ellipse cx="150" cy="195" rx="80" ry="5" fill="#333" opacity="0.8" />
  
  <!-- Bomb Body -->
  <circle cx="150" cy="130" r="25" fill="url(#bombGrad)" stroke="#999" stroke-width="1"/>
  
  <!-- Bomb Shine/Highlight -->
  <ellipse cx="140" cy="115" rx="8" ry="12" fill="#666" opacity="0.6"/>
  
  <!-- Fuse -->
  <path d="M150 105 Q155 95 160 85 Q158 75 165 65" 
        stroke="url(#fuseGrad)" stroke-width="3" fill="none"/>
  
  <!-- Fuse Spark -->
  <circle cx="165" cy="65" r="3" fill="#ff4757" opacity="0.9">
    <animate attributeName="opacity" values="0.9;1;0.5;1;0.9" dur="0.5s" repeatCount="indefinite"/>
    <animate attributeName="r" values="3;4;2;4;3" dur="0.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Fuse Burning Effect -->
  <g opacity="0.8">
    <circle cx="162" cy="68" r="1.5" fill="#ffd700">
      <animate attributeName="opacity" values="0.8;1;0.3;1;0.8" dur="0.3s" repeatCount="indefinite"/>
    </circle>
    <circle cx="159" cy="71" r="1.2" fill="#ff6b35">
      <animate attributeName="opacity" values="0.8;1;0.4;1;0.8" dur="0.4s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Main Explosion Effect -->
  <circle cx="150" cy="130" r="40" fill="url(#explosionGrad)" opacity="0.7">
    <animate attributeName="r" values="35;50;30;50;35" dur="1.2s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.7;1;0.4;1;0.7" dur="1.2s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Explosion Burst Lines -->
  <g stroke="#fff" stroke-width="3" opacity="0.8">
    <line x1="150" y1="130" x2="190" y2="130">
      <animate attributeName="x2" values="190;210;185;210;190" dur="1s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;1;0.3;1;0.8" dur="1s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="130" x2="110" y2="130">
      <animate attributeName="x2" values="110;90;115;90;110" dur="1.1s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;1;0.4;1;0.8" dur="1.1s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="130" x2="150" y2="90">
      <animate attributeName="y2" values="90;70;95;70;90" dur="0.9s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;1;0.5;1;0.8" dur="0.9s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="130" x2="150" y2="170">
      <animate attributeName="y2" values="170;190;165;190;170" dur="1.3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;1;0.2;1;0.8" dur="1.3s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Diagonal Explosion Lines -->
  <g stroke="#ffd700" stroke-width="2" opacity="0.7">
    <line x1="150" y1="130" x2="185" y2="95">
      <animate attributeName="x2" values="185;200;180;200;185" dur="0.8s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="95;80;100;80;95" dur="0.8s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.3;1;0.7" dur="0.8s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="130" x2="115" y2="95">
      <animate attributeName="x2" values="115;100;120;100;115" dur="1s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="95;80;100;80;95" dur="1s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.4;1;0.7" dur="1s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="130" x2="185" y2="165">
      <animate attributeName="x2" values="185;200;180;200;185" dur="1.2s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="165;180;160;180;165" dur="1.2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.2;1;0.7" dur="1.2s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="130" x2="115" y2="165">
      <animate attributeName="x2" values="115;100;120;100;115" dur="0.9s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="165;180;160;180;165" dur="0.9s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.5;1;0.7" dur="0.9s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Sound Wave Rings -->
  <circle cx="150" cy="130" r="60" stroke="#fff" stroke-width="2" fill="none" opacity="0.4">
    <animate attributeName="r" values="55;70;50;70;55" dur="2s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.4;0.1;0.5;0.1;0.4" dur="2s" repeatCount="indefinite"/>
  </circle>
  
  <circle cx="150" cy="130" r="80" stroke="#ffd700" stroke-width="1.5" fill="none" opacity="0.3">
    <animate attributeName="r" values="75;90;70;90;75" dur="2.5s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.3;0.05;0.4;0.05;0.3" dur="2.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Flying Debris -->
  <g>
    <circle cx="200" cy="100" r="2" fill="#999" opacity="0.8">
      <animate attributeName="cx" values="200;220;200" dur="1.5s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="100;80;100" dur="1.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;0.3;0.8" dur="1.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="100" cy="160" r="1.8" fill="#666" opacity="0.9">
      <animate attributeName="cx" values="100;80;100" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="160;180;160" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.9;0.2;0.9" dur="1.8s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Warning Text -->
  <text x="150" y="40" text-anchor="middle" fill="#ff4757" font-family="Arial, sans-serif" font-size="12" font-weight="bold" opacity="0.8">
    ⚠️ LOUD SOUND ⚠️
  </text>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="100" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="60" y="187" text-anchor="middle" fill="#ff4757" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Celebration Bomb
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>