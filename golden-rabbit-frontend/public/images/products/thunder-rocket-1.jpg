<!-- Thunder Rocket Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#0f0f23;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="rocketGrad" x1="50%" y1="100%" x2="50%" y2="0%">
      <stop offset="0%" style="stop-color:#ff4757;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#ffd700;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#ff6b35;stop-opacity:0.8" />
    </linearGradient>
    <radialGradient id="explosionGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#fff;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#ffd700;stop-opacity:0.8" />
      <stop offset="70%" style="stop-color:#ff4757;stop-opacity:0.5" />
      <stop offset="100%" style="stop-color:#ff6b35;stop-opacity:0.2" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#skyGrad)" />
  
  <!-- Stars -->
  <circle cx="50" cy="30" r="1" fill="#fff" opacity="0.7">
    <animate attributeName="opacity" values="0.7;1;0.3;1;0.7" dur="3s" repeatCount="indefinite"/>
  </circle>
  <circle cx="80" cy="45" r="0.8" fill="#ffd700" opacity="0.6">
    <animate attributeName="opacity" values="0.6;0.9;0.2;0.9;0.6" dur="2.5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="250" cy="25" r="1.2" fill="#fff" opacity="0.8">
    <animate attributeName="opacity" values="0.8;1;0.4;1;0.8" dur="3.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Ground -->
  <ellipse cx="150" cy="195" rx="80" ry="5" fill="#2c2c2c" opacity="0.6" />
  
  <!-- Rocket Launch Trail -->
  <path d="M150 190 Q148 140 145 90 Q152 60 155 30 Q158 60 160 90 Q152 140 150 190" 
        fill="url(#rocketGrad)" opacity="0.7">
    <animate attributeName="opacity" values="0.7;1;0.4;1;0.7" dur="1.5s" repeatCount="indefinite"/>
  </path>
  
  <!-- Rocket Body -->
  <ellipse cx="150" cy="35" rx="8" ry="15" fill="#c0392b" opacity="0.9">
    <animate attributeName="cy" values="35;25;35" dur="2s" repeatCount="indefinite"/>
  </ellipse>
  
  <!-- Rocket Tip -->
  <path d="M150 20 L145 35 L155 35 Z" fill="#e74c3c">
    <animate attributeName="transform" values="translate(0,0);translate(0,-10);translate(0,0)" dur="2s" repeatCount="indefinite"/>
  </path>
  
  <!-- High Altitude Explosion -->
  <circle cx="150" cy="30" r="20" fill="url(#explosionGrad)" opacity="0.6">
    <animate attributeName="r" values="15;25;10;25;15" dur="1.8s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.6;1;0.3;1;0.6" dur="1.8s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Explosion Sparks -->
  <g>
    <line x1="150" y1="30" x2="180" y2="20" stroke="#ffd700" stroke-width="2" opacity="0.8">
      <animate attributeName="opacity" values="0.8;1;0.2;1;0.8" dur="1.2s" repeatCount="indefinite"/>
      <animate attributeName="x2" values="180;190;175;190;180" dur="1.2s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="30" x2="120" y2="20" stroke="#ff4757" stroke-width="2" opacity="0.7">
      <animate attributeName="opacity" values="0.7;1;0.3;1;0.7" dur="1.4s" repeatCount="indefinite"/>
      <animate attributeName="x2" values="120;110;125;110;120" dur="1.4s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="30" x2="170" y2="10" stroke="#ff6b35" stroke-width="1.5" opacity="0.9">
      <animate attributeName="opacity" values="0.9;1;0.4;1;0.9" dur="1.1s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="10;5;15;5;10" dur="1.1s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="30" x2="130" y2="10" stroke="#ffd700" stroke-width="1.5" opacity="0.8">
      <animate attributeName="opacity" values="0.8;1;0.2;1;0.8" dur="1.3s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="10;3;12;3;10" dur="1.3s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Flying Debris -->
  <circle cx="185" cy="25" r="1.5" fill="#ffd700" opacity="0.7">
    <animate attributeName="opacity" values="0.7;1;0.2;1;0.7" dur="0.9s" repeatCount="indefinite"/>
    <animate attributeName="cx" values="185;200;185" dur="2s" repeatCount="indefinite"/>
  </circle>
  <circle cx="115" cy="25" r="1.2" fill="#ff4757" opacity="0.8">
    <animate attributeName="opacity" values="0.8;1;0.3;1;0.8" dur="1.1s" repeatCount="indefinite"/>
    <animate attributeName="cx" values="115;100;115" dur="2.2s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Sound Wave Effects -->
  <circle cx="150" cy="30" r="35" stroke="#fff" stroke-width="1" fill="none" opacity="0.3">
    <animate attributeName="r" values="30;45;30" dur="2s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.3;0.1;0.3" dur="2s" repeatCount="indefinite"/>
  </circle>
  <circle cx="150" cy="30" r="50" stroke="#ffd700" stroke-width="0.8" fill="none" opacity="0.2">
    <animate attributeName="r" values="45;60;45" dur="2.5s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.2;0.05;0.2" dur="2.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="90" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="55" y="187" text-anchor="middle" fill="#ffd700" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Thunder Rocket
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>