<!-- Spinning Wonder Chakkar Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="groundGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f2027;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#203a43;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2c5364;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="spinGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#ffd700;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#ffed4e;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#ff6b35;stop-opacity:0.4" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#groundGrad)" />
  
  <!-- Ground -->
  <ellipse cx="150" cy="180" rx="120" ry="15" fill="#1a1a1a" opacity="0.6" />
  
  <!-- Spinning Chakkar Base -->
  <circle cx="150" cy="120" r="4" fill="#8b4513" />
  
  <!-- Main Spinning Effect -->
  <circle cx="150" cy="120" r="25" fill="url(#spinGrad)" opacity="0.7">
    <animate attributeName="r" values="20;30;20" dur="1.5s" repeatCount="indefinite"/>
    <animateTransform attributeName="transform" type="rotate" values="0 150 120;360 150 120" dur="2s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Spinning Sparks -->
  <g>
    <animateTransform attributeName="transform" type="rotate" values="0 150 120;360 150 120" dur="1s" repeatCount="indefinite"/>
    
    <!-- Spark trails -->
    <line x1="150" y1="120" x2="185" y2="120" stroke="#ffd700" stroke-width="3" opacity="0.8">
      <animate attributeName="opacity" values="0.8;1;0.3" dur="0.8s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="120" x2="150" y2="85" stroke="#ffed4e" stroke-width="2" opacity="0.7">
      <animate attributeName="opacity" values="0.7;1;0.4" dur="0.9s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="120" x2="115" y2="120" stroke="#ff6b35" stroke-width="3" opacity="0.6">
      <animate attributeName="opacity" values="0.6;1;0.2" dur="0.7s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="120" x2="150" y2="155" stroke="#ffd700" stroke-width="2" opacity="0.8">
      <animate attributeName="opacity" values="0.8;1;0.3" dur="1.1s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Secondary spinning sparks -->
  <g>
    <animateTransform attributeName="transform" type="rotate" values="360 150 120;0 150 120" dur="1.5s" repeatCount="indefinite"/>
    
    <line x1="150" y1="120" x2="175" y2="95" stroke="#ffed4e" stroke-width="1.5" opacity="0.5">
      <animate attributeName="opacity" values="0.5;0.9;0.2" dur="0.6s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="120" x2="175" y2="145" stroke="#ff6b35" stroke-width="1.5" opacity="0.6">
      <animate attributeName="opacity" values="0.6;0.9;0.3" dur="0.8s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="120" x2="125" y2="95" stroke="#ffd700" stroke-width="1.5" opacity="0.4">
      <animate attributeName="opacity" values="0.4;0.8;0.1" dur="0.7s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="120" x2="125" y2="145" stroke="#ffed4e" stroke-width="1.5" opacity="0.7">
      <animate attributeName="opacity" values="0.7;1;0.3" dur="0.9s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Flying sparks -->
  <circle cx="185" cy="120" r="1.5" fill="#ffd700" opacity="0.6">
    <animate attributeName="opacity" values="0.6;1;0.2" dur="1.2s" repeatCount="indefinite"/>
    <animate attributeName="r" values="1;2.5;0.5" dur="1.2s" repeatCount="indefinite"/>
  </circle>
  <circle cx="115" cy="120" r="1.2" fill="#ff6b35" opacity="0.7">
    <animate attributeName="opacity" values="0.7;1;0.3" dur="1s" repeatCount="indefinite"/>
    <animate attributeName="r" values="0.8;2;0.8" dur="1s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="130" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="75" y="187" text-anchor="middle" fill="#ffd700" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Spinning Wonder Chakkar
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>