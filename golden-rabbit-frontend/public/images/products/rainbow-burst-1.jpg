<!-- Rainbow Burst Sky Shot Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="nightSky" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0c0c1a;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="rainbowBurst" cx="50%" cy="35%" r="45%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:1" />
      <stop offset="20%" style="stop-color:#ff4444;stop-opacity:0.9" />
      <stop offset="40%" style="stop-color:#44ff44;stop-opacity:0.8" />
      <stop offset="60%" style="stop-color:#4444ff;stop-opacity:0.7" />
      <stop offset="80%" style="stop-color:#ffff44;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#ff44ff;stop-opacity:0.3" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#nightSky)" />
  
  <!-- Ground -->
  <rect x="0" y="170" width="300" height="30" fill="#0a0a0a" opacity="0.9" />
  
  <!-- Launch Trail -->
  <path d="M60 170 Q90 130 130 70" stroke="#ffffff" stroke-width="2" fill="none" opacity="0.5">
    <animate attributeName="opacity" values="0.5;0.9;0.5" dur="2.5s" repeatCount="indefinite"/>
  </path>
  
  <!-- Main Rainbow Burst -->
  <circle cx="130" cy="70" r="35" fill="url(#rainbowBurst)" opacity="0.9">
    <animate attributeName="r" values="30;40;30" dur="3.5s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.9;1;0.9" dur="3.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Rainbow Sparks -->
  <g opacity="0.8">
    <!-- Red sparks -->
    <line x1="130" y1="70" x2="100" y2="40" stroke="#ff4444" stroke-width="3">
      <animate attributeName="opacity" values="0.8;1;0.4" dur="2s" repeatCount="indefinite"/>
    </line>
    <line x1="130" y1="70" x2="110" y2="100" stroke="#ff4444" stroke-width="2">
      <animate attributeName="opacity" values="0.4;1;0.8" dur="2.2s" repeatCount="indefinite"/>
    </line>
    
    <!-- Green sparks -->
    <line x1="130" y1="70" x2="160" y2="40" stroke="#44ff44" stroke-width="3">
      <animate attributeName="opacity" values="0.6;1;0.3" dur="2.3s" repeatCount="indefinite"/>
    </line>
    <line x1="130" y1="70" x2="150" y2="100" stroke="#44ff44" stroke-width="2">
      <animate attributeName="opacity" values="0.3;1;0.6" dur="2.1s" repeatCount="indefinite"/>
    </line>
    
    <!-- Blue sparks -->
    <line x1="130" y1="70" x2="170" y2="75" stroke="#4444ff" stroke-width="3">
      <animate attributeName="opacity" values="0.7;1;0.2" dur="2.4s" repeatCount="indefinite"/>
    </line>
    <line x1="130" y1="70" x2="90" y2="75" stroke="#4444ff" stroke-width="2">
      <animate attributeName="opacity" values="0.2;1;0.7" dur="1.9s" repeatCount="indefinite"/>
    </line>
    
    <!-- Yellow sparks -->
    <line x1="130" y1="70" x2="105" y2="45" stroke="#ffff44" stroke-width="2">
      <animate attributeName="opacity" values="0.5;0.9;0.3" dur="1.8s" repeatCount="indefinite"/>
    </line>
    <line x1="130" y1="70" x2="155" y2="45" stroke="#ffff44" stroke-width="2">
      <animate attributeName="opacity" values="0.3;0.9;0.5" dur="2.6s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Colorful particles -->
  <circle cx="105" cy="50" r="2.5" fill="#ff4444" opacity="0.7">
    <animate attributeName="opacity" values="0.7;1;0.3" dur="1.6s" repeatCount="indefinite"/>
    <animate attributeName="r" values="1.5;3;1.5" dur="1.6s" repeatCount="indefinite"/>
  </circle>
  <circle cx="155" cy="50" r="2" fill="#44ff44" opacity="0.6">
    <animate attributeName="opacity" values="0.6;1;0.2" dur="1.4s" repeatCount="indefinite"/>
    <animate attributeName="r" values="1;2.5;1" dur="1.4s" repeatCount="indefinite"/>
  </circle>
  <circle cx="140" cy="100" r="1.8" fill="#4444ff" opacity="0.8">
    <animate attributeName="opacity" values="0.8;1;0.4" dur="1.7s" repeatCount="indefinite"/>
    <animate attributeName="r" values="1;2.2;1" dur="1.7s" repeatCount="indefinite"/>
  </circle>
  <circle cx="115" cy="90" r="2.2" fill="#ffff44" opacity="0.5">
    <animate attributeName="opacity" values="0.5;0.9;0.2" dur="1.3s" repeatCount="indefinite"/>
    <animate attributeName="r" values="1.2;2.8;1.2" dur="1.3s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Product Label -->
  <rect x="5" y="175" width="140" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="75" y="187" text-anchor="middle" fill="#ffffff" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Rainbow Burst Sky Shot
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>