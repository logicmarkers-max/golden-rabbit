<!-- Snake Tablet Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="groundGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2c3e50;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4a6741;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="smokeGrad" x1="50%" y1="100%" x2="50%" y2="0%">
      <stop offset="0%" style="stop-color:#95a5a6;stop-opacity:0.8" />
      <stop offset="50%" style="stop-color:#bdc3c7;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#ecf0f1;stop-opacity:0.3" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#groundGrad)" />
  
  <!-- Ground -->
  <ellipse cx="150" cy="195" rx="80" ry="5" fill="#2c2c2c" opacity="0.6" />
  
  <!-- Tablet Base -->
  <rect x="140" y="180" width="20" height="4" fill="#7f8c8d" rx="2"/>
  
  <!-- Main Smoke Column -->
  <path d="M150 180 Q145 150 148 120 Q152 90 148 60 Q145 30 150 10" 
        stroke="url(#smokeGrad)" stroke-width="8" fill="none" opacity="0.7">
    <animate attributeName="opacity" values="0.7;1;0.5;1;0.7" dur="3s" repeatCount="indefinite"/>
  </path>
  
  <!-- Snake-like Smoke Curves -->
  <path d="M150 180 Q170 160 160 140 Q145 120 165 100 Q180 80 160 60 Q140 40 155 20" 
        stroke="#95a5a6" stroke-width="6" fill="none" opacity="0.6">
    <animate attributeName="opacity" values="0.6;0.9;0.4;0.9;0.6" dur="3.5s" repeatCount="indefinite"/>
  </path>
  
  <path d="M150 180 Q130 160 140 140 Q155 120 135 100 Q120 80 140 60 Q160 40 145 20" 
        stroke="#bdc3c7" stroke-width="5" fill="none" opacity="0.5">
    <animate attributeName="opacity" values="0.5;0.8;0.3;0.8;0.5" dur="4s" repeatCount="indefinite"/>
  </path>
  
  <!-- Curling Smoke Spirals -->
  <g opacity="0.6">
    <path d="M150 140 Q165 135 170 125 Q175 115 165 110 Q155 105 150 115" 
          stroke="#ecf0f1" stroke-width="3" fill="none">
      <animate attributeName="opacity" values="0.6;1;0.3;1;0.6" dur="2.5s" repeatCount="indefinite"/>
      <animateTransform attributeName="transform" type="rotate" values="0 150 125;360 150 125" dur="8s" repeatCount="indefinite"/>
    </path>
    
    <path d="M150 100 Q135 95 130 85 Q125 75 135 70 Q145 65 150 75" 
          stroke="#bdc3c7" stroke-width="2.5" fill="none">
      <animate attributeName="opacity" values="0.6;1;0.2;1;0.6" dur="3s" repeatCount="indefinite"/>
      <animateTransform attributeName="transform" type="rotate" values="360 150 85;0 150 85" dur="10s" repeatCount="indefinite"/>
    </path>
  </g>
  
  <!-- Smoke Puffs -->
  <g>
    <circle cx="155" cy="60" r="8" fill="#ecf0f1" opacity="0.5">
      <animate attributeName="cy" values="60;40;60" dur="4s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.5;0.8;0.2;0.8;0.5" dur="4s" repeatCount="indefinite"/>
      <animate attributeName="r" values="6;10;4;10;6" dur="4s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="145" cy="80" r="6" fill="#bdc3c7" opacity="0.6">
      <animate attributeName="cy" values="80;60;80" dur="3.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.6;0.9;0.3;0.9;0.6" dur="3.5s" repeatCount="indefinite"/>
      <animate attributeName="r" values="5;8;3;8;5" dur="3.5s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="165" cy="100" r="5" fill="#95a5a6" opacity="0.7">
      <animate attributeName="cy" values="100;80;100" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.4;1;0.7" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="r" values="4;7;2;7;4" dur="3s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="135" cy="120" r="7" fill="#ecf0f1" opacity="0.4">
      <animate attributeName="cy" values="120;100;120" dur="4.2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.4;0.7;0.1;0.7;0.4" dur="4.2s" repeatCount="indefinite"/>
      <animate attributeName="r" values="5;9;3;9;5" dur="4.2s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Floating Smoke Particles -->
  <g>
    <circle cx="180" cy="70" r="2" fill="#bdc3c7" opacity="0.5">
      <animate attributeName="cy" values="70;50;70" dur="5s" repeatCount="indefinite"/>
      <animate attributeName="cx" values="180;190;180" dur="5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.5;0.8;0.1;0.8;0.5" dur="5s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="120" cy="90" r="1.5" fill="#95a5a6" opacity="0.6">
      <animate attributeName="cy" values="90;70;90" dur="4.5s" repeatCount="indefinite"/>
      <animate attributeName="cx" values="120;110;120" dur="4.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.6;0.9;0.2;0.9;0.6" dur="4.5s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="170" cy="45" r="1.8" fill="#ecf0f1" opacity="0.4">
      <animate attributeName="cy" values="45;25;45" dur="6s" repeatCount="indefinite"/>
      <animate attributeName="cx" values="170;185;170" dur="6s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.4;0.7;0.1;0.7;0.4" dur="6s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Base Glow -->
  <ellipse cx="150" cy="180" rx="15" ry="3" fill="#e67e22" opacity="0.6">
    <animate attributeName="opacity" values="0.6;0.9;0.4;0.9;0.6" dur="2s" repeatCount="indefinite"/>
  </ellipse>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="85" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="52" y="187" text-anchor="middle" fill="#95a5a6" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Snake Tablet
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>