<!-- Atom Bomb Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="atomGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#fff;stop-opacity:1" />
      <stop offset="20%" style="stop-color:#ffd700;stop-opacity:0.9" />
      <stop offset="50%" style="stop-color:#ff4757;stop-opacity:0.7" />
      <stop offset="80%" style="stop-color:#ff6b35;stop-opacity:0.5" />
      <stop offset="100%" style="stop-color:#2c5364;stop-opacity:0.2" />
    </radialGradient>
    <linearGradient id="groundGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2c2c2c;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#groundGrad)" />
  
  <!-- Ground -->
  <ellipse cx="150" cy="195" rx="120" ry="5" fill="#333" opacity="0.8" />
  
  <!-- Main Explosion Core -->
  <circle cx="150" cy="100" r="35" fill="url(#atomGrad)" opacity="0.9">
    <animate attributeName="r" values="30;45;25;45;30" dur="2s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.9;1;0.7;1;0.9" dur="2s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Inner White Core -->
  <circle cx="150" cy="100" r="15" fill="#fff" opacity="1">
    <animate attributeName="r" values="12;18;10;18;12" dur="1.8s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="1;0.8;1" dur="1.8s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Multiple Explosion Rings -->
  <circle cx="150" cy="100" r="50" stroke="#ffd700" stroke-width="3" fill="none" opacity="0.6">
    <animate attributeName="r" values="45;60;40;60;45" dur="2.2s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.6;0.3;0.8;0.3;0.6" dur="2.2s" repeatCount="indefinite"/>
  </circle>
  
  <circle cx="150" cy="100" r="70" stroke="#ff4757" stroke-width="2" fill="none" opacity="0.4">
    <animate attributeName="r" values="65;80;60;80;65" dur="2.5s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.4;0.1;0.6;0.1;0.4" dur="2.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Radiating Explosion Lines -->
  <g stroke="#ffd700" stroke-width="3" opacity="0.8">
    <line x1="150" y1="100" x2="200" y2="100">
      <animate attributeName="x2" values="200;220;190;220;200" dur="1.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;1;0.4;1;0.8" dur="1.5s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="100" x2="100" y2="100">
      <animate attributeName="x2" values="100;80;110;80;100" dur="1.6s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;1;0.3;1;0.8" dur="1.6s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="100" x2="150" y2="50">
      <animate attributeName="y2" values="50;30;60;30;50" dur="1.4s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;1;0.5;1;0.8" dur="1.4s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="100" x2="150" y2="150">
      <animate attributeName="y2" values="150;170;140;170;150" dur="1.7s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;1;0.4;1;0.8" dur="1.7s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Diagonal Explosion Lines -->
  <g stroke="#ff4757" stroke-width="2" opacity="0.7">
    <line x1="150" y1="100" x2="185" y2="65">
      <animate attributeName="x2" values="185;200;180;200;185" dur="1.3s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="65;50;70;50;65" dur="1.3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.3;1;0.7" dur="1.3s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="100" x2="115" y2="65">
      <animate attributeName="x2" values="115;100;120;100;115" dur="1.5s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="65;50;70;50;65" dur="1.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.4;1;0.7" dur="1.5s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="100" x2="185" y2="135">
      <animate attributeName="x2" values="185;200;180;200;185" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="135;150;130;150;135" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.2;1;0.7" dur="1.8s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="100" x2="115" y2="135">
      <animate attributeName="x2" values="115;100;120;100;115" dur="1.6s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="135;150;130;150;135" dur="1.6s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.3;1;0.7" dur="1.6s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Flying Debris -->
  <g>
    <circle cx="200" cy="80" r="2" fill="#ff6b35" opacity="0.8">
      <animate attributeName="cx" values="200;230;200" dur="2s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="80;60;80" dur="2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;0.3;0.8" dur="2s" repeatCount="indefinite"/>
    </circle>
    <circle cx="100" cy="120" r="1.8" fill="#ffd700" opacity="0.9">
      <animate attributeName="cx" values="100;70;100" dur="2.3s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="120;140;120" dur="2.3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.9;0.2;0.9" dur="2.3s" repeatCount="indefinite"/>
    </circle>
    <circle cx="180" cy="130" r="1.5" fill="#ff4757" opacity="0.7">
      <animate attributeName="cx" values="180;210;180" dur="1.9s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="130;150;130" dur="1.9s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;0.1;0.7" dur="1.9s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Shockwave Effect -->
  <circle cx="150" cy="100" r="90" stroke="#fff" stroke-width="1" fill="none" opacity="0.3">
    <animate attributeName="r" values="85;100;80;100;85" dur="3s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.3;0.1;0.4;0.1;0.3" dur="3s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="80" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="50" y="187" text-anchor="middle" fill="#ffd700" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Atom Bomb
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>