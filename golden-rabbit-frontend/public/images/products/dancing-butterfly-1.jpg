<!-- Dancing Butterfly Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="skyGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#87ceeb;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#4682b4;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#191970;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="butterflyGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#ff69b4;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#ffd700;stop-opacity:0.9" />
      <stop offset="70%" style="stop-color:#ff1493;stop-opacity:0.7" />
      <stop offset="100%" style="stop-color:#8a2be2;stop-opacity:0.5" />
    </radialGradient>
    <linearGradient id="sparkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fff;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#ffd700;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#ff69b4;stop-opacity:0.5" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#skyGradient)" />
  
  <!-- Ground -->
  <ellipse cx="150" cy="195" rx="60" ry="5" fill="#2f4f4f" opacity="0.6" />
  
  <!-- Butterfly Body -->
  <ellipse cx="150" cy="100" rx="3" ry="15" fill="#8b4513">
    <animateTransform attributeName="transform" type="rotate" values="0 150 100;15 150 100;-15 150 100;0 150 100" dur="2s" repeatCount="indefinite"/>
  </ellipse>
  
  <!-- Butterfly Wings (Upper) -->
  <ellipse cx="140" cy="95" rx="12" ry="8" fill="url(#butterflyGrad)" opacity="0.8">
    <animateTransform attributeName="transform" type="rotate" values="0 150 100;20 150 100;-20 150 100;0 150 100" dur="1.5s" repeatCount="indefinite"/>
  </ellipse>
  <ellipse cx="160" cy="95" rx="12" ry="8" fill="url(#butterflyGrad)" opacity="0.8">
    <animateTransform attributeName="transform" type="rotate" values="0 150 100;-20 150 100;20 150 100;0 150 100" dur="1.5s" repeatCount="indefinite"/>
  </ellipse>
  
  <!-- Butterfly Wings (Lower) -->
  <ellipse cx="142" cy="105" rx="8" ry="6" fill="url(#butterflyGrad)" opacity="0.7">
    <animateTransform attributeName="transform" type="rotate" values="0 150 100;15 150 100;-15 150 100;0 150 100" dur="1.8s" repeatCount="indefinite"/>
  </ellipse>
  <ellipse cx="158" cy="105" rx="8" ry="6" fill="url(#butterflyGrad)" opacity="0.7">
    <animateTransform attributeName="transform" type="rotate" values="0 150 100;-15 150 100;15 150 100;0 150 100" dur="1.8s" repeatCount="indefinite"/>
  </ellipse>
  
  <!-- Wing Patterns -->
  <g opacity="0.6">
    <circle cx="135" cy="92" r="3" fill="#fff">
      <animateTransform attributeName="transform" type="rotate" values="0 150 100;20 150 100;-20 150 100;0 150 100" dur="1.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="165" cy="92" r="3" fill="#fff">
      <animateTransform attributeName="transform" type="rotate" values="0 150 100;-20 150 100;20 150 100;0 150 100" dur="1.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="140" cy="108" r="2" fill="#ff1493">
      <animateTransform attributeName="transform" type="rotate" values="0 150 100;15 150 100;-15 150 100;0 150 100" dur="1.8s" repeatCount="indefinite"/>
    </circle>
    <circle cx="160" cy="108" r="2" fill="#ff1493">
      <animateTransform attributeName="transform" type="rotate" values="0 150 100;-15 150 100;15 150 100;0 150 100" dur="1.8s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Antennae -->
  <line x1="147" y1="85" x2="145" y2="78" stroke="#8b4513" stroke-width="1">
    <animateTransform attributeName="transform" type="rotate" values="0 150 100;15 150 100;-15 150 100;0 150 100" dur="2s" repeatCount="indefinite"/>
  </line>
  <line x1="153" y1="85" x2="155" y2="78" stroke="#8b4513" stroke-width="1">
    <animateTransform attributeName="transform" type="rotate" values="0 150 100;15 150 100;-15 150 100;0 150 100" dur="2s" repeatCount="indefinite"/>
  </line>
  <circle cx="145" cy="78" r="1" fill="#ffd700">
    <animateTransform attributeName="transform" type="rotate" values="0 150 100;15 150 100;-15 150 100;0 150 100" dur="2s" repeatCount="indefinite"/>
  </circle>
  <circle cx="155" cy="78" r="1" fill="#ffd700">
    <animateTransform attributeName="transform" type="rotate" values="0 150 100;15 150 100;-15 150 100;0 150 100" dur="2s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Colorful Spark Trail -->
  <g>
    <circle cx="180" cy="80" r="2" fill="#ff69b4" opacity="0.8">
      <animate attributeName="cx" values="180;200;220;200;180" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="80;60;70;90;80" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;0.4;0.9;0.3;0.8" dur="3s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="170" cy="120" r="1.8" fill="#ffd700" opacity="0.9">
      <animate attributeName="cx" values="170;190;210;190;170" dur="3.2s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="120;140;130;110;120" dur="3.2s" repeatCount="indefinitive"/>
      <animate attributeName="opacity" values="0.9;0.3;0.8;0.4;0.9" dur="3.2s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="120" cy="90" r="1.5" fill="#8a2be2" opacity="0.7">
      <animate attributeName="cx" values="120;100;80;100;120" dur="2.8s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="90;70;80;110;90" dur="2.8s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;0.2;0.8;0.3;0.7" dur="2.8s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="130" cy="130" r="1.3" fill="#ff1493" opacity="0.6">
      <animate attributeName="cx" values="130;110;90;110;130" dur="3.5s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="130;150;140;120;130" dur="3.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.6;0.1;0.7;0.2;0.6" dur="3.5s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Floating Sparkles -->
  <g>
    <circle cx="200" cy="50" r="1" fill="url(#sparkGrad)" opacity="0.8">
      <animate attributeName="cy" values="50;40;50" dur="2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;1;0.4;1;0.8" dur="2s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="80" cy="60" r="0.8" fill="url(#sparkGrad)" opacity="0.9">
      <animate attributeName="cy" values="60;50;60" dur="2.3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.9;1;0.3;1;0.9" dur="2.3s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="250" cy="100" r="1.2" fill="url(#sparkGrad)" opacity="0.7">
      <animate attributeName="cy" values="100;90;100" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;1;0.2;1;0.7" dur="1.8s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="50" cy="120" r="0.9" fill="url(#sparkGrad)" opacity="0.6">
      <animate attributeName="cy" values="120;110;120" dur="2.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.6;1;0.3;1;0.6" dur="2.5s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Flight Path -->
  <path d="M50 150 Q100 120 150 100 Q200 80 250 60" 
        stroke="url(#sparkGrad)" stroke-width="1" fill="none" opacity="0.4" stroke-dasharray="5,5">
    <animate attributeName="stroke-dashoffset" values="0;10;0" dur="2s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.4;0.7;0.2;0.7;0.4" dur="3s" repeatCount="indefinite"/>
  </path>
  
  <!-- Magic Glow Around Butterfly -->
  <circle cx="150" cy="100" r="25" fill="url(#butterflyGrad)" opacity="0.2">
    <animate attributeName="opacity" values="0.2;0.4;0.1;0.4;0.2" dur="2.5s" repeatCount="indefinite"/>
    <animate attributeName="r" values="20;30;18;30;20" dur="2.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="110" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="65" y="187" text-anchor="middle" fill="#ff69b4" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Dancing Butterfly
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>