<!-- Majestic Fountain Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="nightGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a0a;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="fountainGrad" x1="50%" y1="100%" x2="50%" y2="0%">
      <stop offset="0%" style="stop-color:#ff4757;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#ffd700;stop-opacity:0.8" />
      <stop offset="70%" style="stop-color:#00d2d3;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#ff6b35;stop-opacity:0.3" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#nightGrad)" />
  
  <!-- Ground -->
  <ellipse cx="150" cy="190" rx="100" ry="8" fill="#2c2c2c" opacity="0.7" />
  
  <!-- Fountain Base -->
  <rect x="140" y="180" width="20" height="15" fill="#654321" rx="2"/>
  
  <!-- Central Fountain Stream -->
  <path d="M150 180 Q148 120 145 60 Q152 50 155 40 Q158 50 160 60 Q152 120 150 180" 
        fill="url(#fountainGrad)" opacity="0.8">
    <animate attributeName="opacity" values="0.8;1;0.6;1;0.8" dur="2s" repeatCount="indefinite"/>
  </path>
  
  <!-- Side Fountain Streams -->
  <path d="M150 180 Q130 150 110 80 Q115 70 120 60" stroke="#ffd700" stroke-width="3" fill="none" opacity="0.7">
    <animate attributeName="opacity" values="0.7;1;0.4;1;0.7" dur="1.8s" repeatCount="indefinite"/>
  </path>
  <path d="M150 180 Q170 150 190 80 Q185 70 180 60" stroke="#ff4757" stroke-width="3" fill="none" opacity="0.6">
    <animate attributeName="opacity" values="0.6;1;0.3;1;0.6" dur="1.9s" repeatCount="indefinite"/>
  </path>
  
  <!-- Fountain Droplets -->
  <g>
    <circle cx="145" cy="80" r="2" fill="#ffd700" opacity="0.8">
      <animate attributeName="cy" values="80;180;80" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;0.3;0.8" dur="3s" repeatCount="indefinite"/>
    </circle>
    <circle cx="155" cy="70" r="1.5" fill="#ff4757" opacity="0.7">
      <animate attributeName="cy" values="70;185;70" dur="2.8s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;0.2;0.7" dur="2.8s" repeatCount="indefinite"/>
    </circle>
    <circle cx="135" cy="90" r="1.8" fill="#00d2d3" opacity="0.6">
      <animate attributeName="cy" values="90;182;90" dur="3.2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.6;0.1;0.6" dur="3.2s" repeatCount="indefinite"/>
    </circle>
    <circle cx="165" cy="85" r="1.3" fill="#ff6b35" opacity="0.9">
      <animate attributeName="cy" values="85;188;85" dur="2.9s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.9;0.2;0.9" dur="2.9s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Sparkling Effects at Top -->
  <g>
    <circle cx="150" cy="40" r="3" fill="#ffd700" opacity="0.8">
      <animate attributeName="opacity" values="0.8;1;0.3;1;0.8" dur="1.5s" repeatCount="indefinite"/>
      <animate attributeName="r" values="2;4;1;4;2" dur="1.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="145" cy="45" r="2" fill="#ff4757" opacity="0.7">
      <animate attributeName="opacity" values="0.7;1;0.2;1;0.7" dur="1.3s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.5;3;0.8;3;1.5" dur="1.3s" repeatCount="indefinite"/>
    </circle>
    <circle cx="155" cy="42" r="1.8" fill="#00d2d3" opacity="0.9">
      <animate attributeName="opacity" values="0.9;1;0.4;1;0.9" dur="1.7s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.2;2.5;0.9;2.5;1.2" dur="1.7s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Outer Spray Effects -->
  <g opacity="0.5">
    <path d="M120 60 Q100 40 80 30" stroke="#ffd700" stroke-width="1.5" fill="none">
      <animate attributeName="opacity" values="0.5;0.9;0.2;0.9;0.5" dur="2.1s" repeatCount="indefinite"/>
    </path>
    <path d="M180 60 Q200 40 220 30" stroke="#ff4757" stroke-width="1.5" fill="none">
      <animate attributeName="opacity" values="0.5;0.9;0.1;0.9;0.5" dur="2.3s" repeatCount="indefinite"/>
    </path>
    <path d="M150 45 Q130 25 110 15" stroke="#00d2d3" stroke-width="1" fill="none">
      <animate attributeName="opacity" values="0.3;0.8;0.1;0.8;0.3" dur="2.5s" repeatCount="indefinite"/>
    </path>
    <path d="M150 45 Q170 25 190 15" stroke="#ff6b35" stroke-width="1" fill="none">
      <animate attributeName="opacity" values="0.4;0.8;0.2;0.8;0.4" dur="2.2s" repeatCount="indefinite"/>
    </path>
  </g>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="110" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="65" y="187" text-anchor="middle" fill="#ffd700" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Majestic Fountain
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>