<!-- Electric Crackers Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="stormGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#191654;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#43c6ac;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#1e3c72;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="lightningGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fff;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#00d2d3;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#74b9ff;stop-opacity:0.6" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#stormGrad)" />
  
  <!-- Ground -->
  <ellipse cx="150" cy="195" rx="100" ry="5" fill="#2c2c54" opacity="0.7" />
  
  <!-- Main Lightning Bolt -->
  <path d="M120 20 L140 60 L125 60 L145 100 L160 70 L150 70 L170 30 L155 30 L175 10 L150 10 L120 20 Z" 
        fill="url(#lightningGrad)" opacity="0.9">
    <animate attributeName="opacity" values="0.9;1;0.6;1;0.9" dur="0.8s" repeatCount="indefinite"/>
  </path>
  
  <!-- Secondary Lightning Bolts -->
  <path d="M80 40 L90 70 L85 70 L95 90 L105 75 L100 75 L110 50 L80 40 Z" 
        fill="#74b9ff" opacity="0.7">
    <animate attributeName="opacity" values="0.7;1;0.4;1;0.7" dur="1.2s" repeatCount="indefinite"/>
  </path>
  
  <path d="M200 35 L210 65 L205 65 L215 85 L225 70 L220 70 L230 45 L200 35 Z" 
        fill="#00d2d3" opacity="0.8">
    <animate attributeName="opacity" values="0.8;1;0.5;1;0.8" dur="1s" repeatCount="indefinite"/>
  </path>
  
  <!-- Electric Arcs -->
  <path d="M150 100 Q170 110 190 120 Q210 130 220 140" 
        stroke="#fff" stroke-width="2" fill="none" opacity="0.8">
    <animate attributeName="opacity" values="0.8;1;0.3;1;0.8" dur="0.6s" repeatCount="indefinite"/>
  </path>
  
  <path d="M150 100 Q130 110 110 120 Q90 130 80 140" 
        stroke="#74b9ff" stroke-width="2" fill="none" opacity="0.7">
    <animate attributeName="opacity" values="0.7;1;0.4;1;0.7" dur="0.9s" repeatCount="indefinite"/>
  </path>
  
  <path d="M150 100 Q160 130 170 160 Q180 170 190 180" 
        stroke="#00d2d3" stroke-width="1.5" fill="none" opacity="0.6">
    <animate attributeName="opacity" values="0.6;1;0.2;1;0.6" dur="1.1s" repeatCount="indefinite"/>
  </path>
  
  <!-- Electric Sparks -->
  <g>
    <circle cx="220" cy="140" r="3" fill="#fff" opacity="0.9">
      <animate attributeName="opacity" values="0.9;1;0.4;1;0.9" dur="0.5s" repeatCount="indefinite"/>
      <animate attributeName="r" values="2;4;1;4;2" dur="0.5s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="80" cy="140" r="2.5" fill="#74b9ff" opacity="0.8">
      <animate attributeName="opacity" values="0.8;1;0.3;1;0.8" dur="0.7s" repeatCount="indefinite"/>
      <animate attributeName="r" values="2;3.5;1.5;3.5;2" dur="0.7s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="190" cy="180" r="2" fill="#00d2d3" opacity="0.7">
      <animate attributeName="opacity" values="0.7;1;0.2;1;0.7" dur="0.8s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.5;3;1;3;1.5" dur="0.8s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Electric Field Lines -->
  <g stroke="#74b9ff" stroke-width="1" opacity="0.5">
    <line x1="150" y1="100" x2="180" y2="90">
      <animate attributeName="opacity" values="0.5;0.9;0.2;0.9;0.5" dur="1.3s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="100" x2="120" y2="90">
      <animate attributeName="opacity" values="0.5;0.9;0.3;0.9;0.5" dur="1.1s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="100" x2="165" y2="120">
      <animate attributeName="opacity" values="0.5;0.9;0.1;0.9;0.5" dur="0.9s" repeatCount="indefinite"/>
    </line>
    <line x1="150" y1="100" x2="135" y2="120">
      <animate attributeName="opacity" values="0.5;0.9;0.4;0.9;0.5" dur="1.2s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Electric Glow -->
  <circle cx="150" cy="100" r="25" fill="#74b9ff" opacity="0.2">
    <animate attributeName="opacity" values="0.2;0.4;0.1;0.4;0.2" dur="1.5s" repeatCount="indefinite"/>
    <animate attributeName="r" values="20;30;18;30;20" dur="1.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Crackling Sound Waves -->
  <circle cx="150" cy="100" r="40" stroke="#fff" stroke-width="0.5" fill="none" opacity="0.3">
    <animate attributeName="r" values="35;50;30;50;35" dur="2s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.3;0.1;0.4;0.1;0.3" dur="2s" repeatCount="indefinite"/>
  </circle>
  
  <circle cx="150" cy="100" r="60" stroke="#00d2d3" stroke-width="0.3" fill="none" opacity="0.2">
    <animate attributeName="r" values="55;70;50;70;55" dur="2.5s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.2;0.05;0.3;0.05;0.2" dur="2.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="110" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="65" y="187" text-anchor="middle" fill="#74b9ff" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Electric Crackers
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>