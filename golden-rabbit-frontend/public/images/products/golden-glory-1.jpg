<!-- Golden Glory Sky Shot Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#16213e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0f3460;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="burstGrad" cx="50%" cy="40%" r="40%">
      <stop offset="0%" style="stop-color:#ffd700;stop-opacity:1" />
      <stop offset="70%" style="stop-color:#ffed4e;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#ff6b35;stop-opacity:0.3" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#skyGrad)" />
  
  <!-- Ground -->
  <rect x="0" y="160" width="300" height="40" fill="#0a0a1a" opacity="0.8" />
  
  <!-- Rocket Launch Trail -->
  <path d="M50 160 Q80 120 120 80" stroke="#ffd700" stroke-width="3" fill="none" opacity="0.6">
    <animate attributeName="opacity" values="0.6;1;0.6" dur="2s" repeatCount="indefinite"/>
  </path>
  
  <!-- Main Burst -->
  <circle cx="120" cy="80" r="30" fill="url(#burstGrad)" opacity="0.8">
    <animate attributeName="r" values="25;35;25" dur="3s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.8;1;0.8" dur="3s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Sparkles -->
  <g stroke="#ffd700" stroke-width="2" opacity="0.7">
    <!-- Primary sparks -->
    <line x1="120" y1="80" x2="90" y2="50">
      <animate attributeName="opacity" values="0.7;1;0.3" dur="2.5s" repeatCount="indefinite"/>
    </line>
    <line x1="120" y1="80" x2="150" y2="50">
      <animate attributeName="opacity" values="0.3;1;0.7" dur="2.2s" repeatCount="indefinite"/>
    </line>
    <line x1="120" y1="80" x2="160" y2="85">
      <animate attributeName="opacity" values="0.7;1;0.3" dur="2.8s" repeatCount="indefinite"/>
    </line>
    <line x1="120" y1="80" x2="80" y2="85">
      <animate attributeName="opacity" values="0.3;1;0.7" dur="2.1s" repeatCount="indefinite"/>
    </line>
    <line x1="120" y1="80" x2="100" y2="110">
      <animate attributeName="opacity" values="0.7;1;0.3" dur="2.6s" repeatCount="indefinite"/>
    </line>
    <line x1="120" y1="80" x2="140" y2="110">
      <animate attributeName="opacity" values="0.3;1;0.7" dur="2.3s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Secondary sparks -->
  <g stroke="#ff6b35" stroke-width="1" opacity="0.5">
    <line x1="120" y1="80" x2="95" y2="65">
      <animate attributeName="opacity" values="0.5;0.8;0.2" dur="1.8s" repeatCount="indefinite"/>
    </line>
    <line x1="120" y1="80" x2="145" y2="65">
      <animate attributeName="opacity" values="0.2;0.8;0.5" dur="1.5s" repeatCount="indefinite"/>
    </line>
    <line x1="120" y1="80" x2="135" y2="95">
      <animate attributeName="opacity" values="0.5;0.8;0.2" dur="1.7s" repeatCount="indefinite"/>
    </line>
    <line x1="120" y1="80" x2="105" y2="95">
      <animate attributeName="opacity" values="0.2;0.8;0.5" dur="1.9s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Glowing particles -->
  <circle cx="95" cy="65" r="2" fill="#ffd700" opacity="0.6">
    <animate attributeName="opacity" values="0.6;1;0.3" dur="1.5s" repeatCount="indefinite"/>
    <animate attributeName="r" values="1;3;1" dur="1.5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="145" cy="65" r="2" fill="#ffed4e" opacity="0.4">
    <animate attributeName="opacity" values="0.4;0.9;0.2" dur="1.8s" repeatCount="indefinite"/>
    <animate attributeName="r" values="1;2.5;1" dur="1.8s" repeatCount="indefinite"/>
  </circle>
  <circle cx="105" cy="95" r="1.5" fill="#ff6b35" opacity="0.5">
    <animate attributeName="opacity" values="0.5;0.8;0.1" dur="1.3s" repeatCount="indefinite"/>
    <animate attributeName="r" values="1;2;1" dur="1.3s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Product Label -->
  <rect x="10" y="170" width="120" height="25" fill="rgba(0,0,0,0.7)" rx="5"/>
  <text x="70" y="185" text-anchor="middle" fill="#ffd700" font-family="Arial, sans-serif" font-size="12" font-weight="bold">
    Golden Glory Sky Shot
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="190" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>