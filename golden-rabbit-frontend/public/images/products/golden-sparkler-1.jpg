<!-- Golden Sparkler Product Image -->
<svg width="300" height="200" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="eveningGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2c3e50;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#3498db;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#34495e;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="sparkGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#fff;stop-opacity:1" />
      <stop offset="40%" style="stop-color:#ffd700;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#ffed4e;stop-opacity:0.3" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="200" fill="url(#eveningGrad)" />
  
  <!-- Ground -->
  <ellipse cx="150" cy="195" rx="70" ry="4" fill="#2c2c2c" opacity="0.5" />
  
  <!-- Sparkler Handle -->
  <rect x="148" y="120" width="4" height="75" fill="#8b4513" rx="2"/>
  
  <!-- Hand holding sparkler (simplified) -->
  <ellipse cx="150" cy="180" rx="15" ry="8" fill="#d4af37" opacity="0.7"/>
  
  <!-- Main Sparkler Tip -->
  <circle cx="150" cy="115" r="8" fill="url(#sparkGrad)" opacity="0.9">
    <animate attributeName="r" values="6;10;6" dur="0.8s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.9;1;0.7;1;0.9" dur="0.8s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Sparkler Core -->
  <circle cx="150" cy="115" r="3" fill="#fff" opacity="1">
    <animate attributeName="opacity" values="1;0.8;1" dur="0.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Flying Sparks -->
  <g>
    <!-- Large sparks -->
    <circle cx="165" cy="105" r="1.8" fill="#ffd700" opacity="0.8">
      <animate attributeName="cx" values="165;190;165" dur="1.5s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="105;95;105" dur="1.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;0.3;0.8" dur="1.5s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.8;0.5;1.8" dur="1.5s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="135" cy="110" r="1.5" fill="#ffed4e" opacity="0.9">
      <animate attributeName="cx" values="135;110;135" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="110;100;110" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.9;0.2;0.9" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.5;0.3;1.5" dur="1.8s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="155" cy="100" r="1.3" fill="#fff" opacity="1">
      <animate attributeName="cx" values="155;175;155" dur="1.2s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="100;80;100" dur="1.2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="1;0.4;1" dur="1.2s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.3;0.4;1.3" dur="1.2s" repeatCount="indefinite"/>
    </circle>
    
    <circle cx="145" cy="108" r="1.1" fill="#ffd700" opacity="0.7">
      <animate attributeName="cx" values="145;125;145" dur="1.6s" repeatCount="indefinite"/>
      <animate attributeName="cy" values="108;88;108" dur="1.6s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;0.1;0.7" dur="1.6s" repeatCount="indefinite"/>
      <animate attributeName="r" values="1.1;0.2;1.1" dur="1.6s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Small floating sparks -->
  <g>
    <circle cx="170" cy="120" r="0.8" fill="#ffd700" opacity="0.6">
      <animate attributeName="cx" values="170;185;170" dur="2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.6;0.1;0.6" dur="2s" repeatCount="indefinite"/>
    </circle>
    <circle cx="130" cy="125" r="0.6" fill="#ffed4e" opacity="0.8">
      <animate attributeName="cx" values="130;115;130" dur="2.2s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.8;0.2;0.8" dur="2.2s" repeatCount="indefinite"/>
    </circle>
    <circle cx="160" cy="90" r="0.9" fill="#fff" opacity="0.9">
      <animate attributeName="cy" values="90;70;90" dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.8s" repeatCount="indefinite"/>
    </circle>
    <circle cx="140" cy="95" r="0.7" fill="#ffd700" opacity="0.5">
      <animate attributeName="cy" values="95;75;95" dur="2.1s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.5;0.1;0.5" dur="2.1s" repeatCount="indefinite"/>
    </circle>
  </g>
  
  <!-- Spark Trails -->
  <g opacity="0.6">
    <path d="M150 115 Q160 110 170 105" stroke="#ffd700" stroke-width="1" fill="none">
      <animate attributeName="opacity" values="0.6;1;0.2;1;0.6" dur="1s" repeatCount="indefinite"/>
    </path>
    <path d="M150 115 Q140 110 130 108" stroke="#ffed4e" stroke-width="1" fill="none">
      <animate attributeName="opacity" values="0.6;1;0.3;1;0.6" dur="1.2s" repeatCount="indefinite"/>
    </path>
    <path d="M150 115 Q155 105 160 95" stroke="#fff" stroke-width="0.8" fill="none">
      <animate attributeName="opacity" values="0.6;1;0.4;1;0.6" dur="0.9s" repeatCount="indefinite"/>
    </path>
    <path d="M150 115 Q145 105 140 98" stroke="#ffd700" stroke-width="0.8" fill="none">
      <animate attributeName="opacity" values="0.6;1;0.2;1;0.6" dur="1.1s" repeatCount="indefinite"/>
    </path>
  </g>
  
  <!-- Glow Effect -->
  <circle cx="150" cy="115" r="20" fill="#ffd700" opacity="0.1">
    <animate attributeName="opacity" values="0.1;0.3;0.1" dur="1.5s" repeatCount="indefinite"/>
    <animate attributeName="r" values="18;22;18" dur="1.5s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Product Label -->
  <rect x="10" y="175" width="100" height="20" fill="rgba(0,0,0,0.8)" rx="3"/>
  <text x="60" y="187" text-anchor="middle" fill="#ffd700" font-family="Arial, sans-serif" font-size="11" font-weight="bold">
    Golden Sparkler
  </text>
  
  <!-- Golden Rabbit Logo -->
  <text x="250" y="193" text-anchor="middle" fill="#ffd700" font-family="serif" font-size="10" opacity="0.8">
    Golden Rabbit
  </text>
</svg>